{
  "name": "Vol Structure",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Vol Structure terminal (synthetic demo)", "onAutoForward": "openBrowser", "protocol": "http" }
  },
  "postStartCommand": "nohup python3 tools/serve_demo.py --port 8080 > /tmp/vol-structure-demo.log 2>&1 &",
  "customizations": { "vscode": { "extensions": ["ms-vscode.cpptools"] } }
}
