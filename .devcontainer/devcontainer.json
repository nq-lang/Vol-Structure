{
  "name": "Vol Structure",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Vol Structure terminal (synthetic demo)", "onAutoForward": "openBrowser", "protocol": "http" }
  },
  "postStartCommand": "python3 tools/start_demo.py",
  "customizations": { "vscode": { "extensions": ["ms-vscode.cpptools"] } }
}
